# ArtifactDepot 隐私配置（本文件是模板，复制为 .env 后填写）
#
# 只写「配置字段名=值」，支持点号嵌套，例如：
#   access_token=你的强随机token
#   max_upload_mb=2048
#   signed_links.count_max=20
#   upload.chunk_size_mb=8
#   upload.request_timeout_seconds=86400
#   upload.chunk_concurrency=4
#   upload.file_concurrency=3
#   upload.staging_dir=/data/depot/.staging
#   download.chunk_size_mb=8
#   download.chunk_concurrency=4
#   download.request_timeout_seconds=3600
#
# 上传相关默认值（一般不用改）：
#   chunk_size_mb=8；chunk_concurrency=4；file_concurrency=3；
#   request_timeout_seconds=86400（24h）；session_ttl_seconds=86400；
#   session_idle_ttl_seconds=86400（24h 空闲清理）
#
# 伴随文件/staging 目录（upload.staging_dir）：
#   留空 = <depot_dir>/.staging；相对路径按 depot_dir 解析；也可写绝对路径（容器挂独立数据卷）。
#   上传分片、合并临时文件、框架 multipart spool 都落在这里（不再写宿主机 /tmp，
#   避免 6.83GiB tmpfs 被 72GB 上传打爆）；启动时创建，改后需重启才完整生效。
#
# 下载相关默认值（一般不用改）：
#   chunk_size_mb=8；chunk_concurrency=4；request_timeout_seconds=3600（1h）
#   桌面客户端/网页按此切 Range 分片并行下载；改后 POST /api/config/reload 即生效
#
# 管理员共享令牌（access_token）：内置默认 admin，config.json 默认也是 admin，
# 仅用于开箱即用/内网联调；生产/公网部署必须改成 >=16 位随机串（否则启动会告警，
# 设 ARTIFACT_DEPOT_STRICT_CONFIG=1 会拒绝启动）。本文件同名项优先于 config.json。
#
# 优先级：config.json < .env < 真实环境变量
# 本文件（.env）不进 git、不进镜像，请放心放密钥。
access_token=
