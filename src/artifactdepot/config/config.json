{
  "depot_dir": "./depot",
  "meta_dir": "",
  "host": "0.0.0.0",
  "port": 8004,
  "access_token": "admin",
  "max_upload_mb": 0,
  "ui_enabled": true,
  "metrics_enabled": true,
  "trusted_proxies": [],
  "audit_max_mb": 50,
  "audit_backups": 5,
  "cors_origins": [],
  "allowed_hosts": ["*"],
  "require_read_token": false,
  "ui": {
    "file_page_size": 200,
    "audit_page_size": 500
  },
  "signed_links": {
    "count_min": 1,
    "count_max": 10,
    "expire_min_seconds": 60,
    "expire_max_seconds": 604800,
    "allow_directory": true
  },
  "package": {
    "enabled": true,
    "max_items": 100000,
    "max_total_mb": 0,
    "max_concurrent_jobs": 1,
    "zip_compression": "stored",
    "cleanup_interval_seconds": 60,
    "cleanup_grace_seconds": 60,
    "delete_on_revoke": true,
    "cleanup_on_startup": true
  },
  "upload": {
    "chunk_size_mb": 8,
    "chunk_concurrency": 4,
    "file_concurrency": 3,
    "request_timeout_seconds": 86400,
    "session_cleanup_interval_seconds": 600,
    "max_chunk_mb": 64,
    "max_chunks": 100000,
    "max_session_gb": 200,
    "session_ttl_seconds": 86400,
    "session_idle_ttl_seconds": 86400,
    "staging_dir": ""
  },
  "download": {
    "chunk_size_mb": 8,
    "chunk_concurrency": 4,
    "request_timeout_seconds": 3600
  },
  "token": {
    "min_length": 5,
    "max_length": 30
  }
}
